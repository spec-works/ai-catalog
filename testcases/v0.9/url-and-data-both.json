{
  "description": "An entry with both url and data violates the exactly-one content source rule.",
  "spec_section": "AI Catalog § Catalog Entry — url and data",
  "spec_revision": {
    "url": "https://github.com/Agent-Card/ai-card/blob/19208af2f8adbc0a6457e3ff36ce691a304fbd97/specification/ai-catalog.md",
    "commit": "19208af2f8adbc0a6457e3ff36ce691a304fbd97"
  },
  "test_ids": ["V09-CE-N01"],
  "input": {
    "specVersion": "0.9",
    "entries": [
      {
        "identifier": "urn:air:contoso.com:conflict",
        "type": "application/json",
        "url": "https://data.contoso.com/item.json",
        "data": {"name": "item"}
      }
    ]
  },
  "expected_error": {
    "code": "exactly_one_content_source",
    "members": ["url", "data"]
  }
}
